---
import { profile } from "../data/profile";

const paragraphs = profile.bio.split("\n\n");
---

<section id="about" aria-labelledby="about-heading" class="py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      id="about-heading"
      class="text-gradient text-3xl md:text-4xl font-bold mb-12"
    >
      About
    </h2>

    <div class="max-w-3xl space-y-6">
      {paragraphs.map((p, i) => (
        <p
          class="reveal text-lg text-[var(--color-muted)] leading-relaxed"
          style={`transition-delay: ${i * 80}ms`}
        >
          {p}
        </p>
      ))}
    </div>
  </div>
</section>
