---
import { profile } from "../data/profile";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] py-8 text-center text-[var(--color-muted)] text-sm">
  <div class="mx-auto max-w-6xl px-6 space-y-2">
    <p>Built with Astro &amp; Tailwind CSS</p>
    <p>
      &copy; {currentYear} {profile.name}. All rights reserved.
    </p>
    <a
      href="#hero"
      class="inline-block mt-2 text-[var(--color-accent)] hover:text-[var(--color-accent-2)] transition-colors"
    >
      Back to top &uarr;
    </a>
  </div>
</footer>
