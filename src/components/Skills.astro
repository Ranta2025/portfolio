---
import { skills } from "../data/skills";
---

<section id="skills" aria-labelledby="skills-heading" class="py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      id="skills-heading"
      class="text-gradient text-3xl md:text-4xl font-bold mb-12"
    >
      Skills
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {skills.map((group, i) => (
        <div
          class="reveal"
          style={`transition-delay: ${i * 100}ms`}
        >
          <h3 class="text-xl font-semibold text-[var(--color-text)] mb-4">
            {group.category}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <li>
                <code
                  class="font-mono text-sm border-l-2 pl-2 pr-3 py-1 rounded inline-block"
                  style={`border-left-color: var(${group.accent})`}
                >
                  {skill}
                </code>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
