---
import { profile } from "../data/profile";
---

<section id="contact" aria-labelledby="contact-heading" class="py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      id="contact-heading"
      class="text-gradient text-3xl md:text-4xl font-bold mb-8"
    >
      Get in Touch
    </h2>

    <div class="reveal max-w-2xl space-y-6">
      <p class="text-lg text-[var(--color-text)]">
        Let's talk — whether it's a role, a project, or just a chat about backend systems.
      </p>

      <div class="flex flex-wrap gap-4">
        <!-- Email primary button -->
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium bg-[var(--color-accent)] text-[var(--color-bg)] hover:opacity-90 transition-opacity"
          aria-label="Email Rafael Tanda"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          {profile.email}
        </a>

        <!-- GitHub secondary -->
        <a
          href={profile.socials.github}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-accent-2)] hover:text-[var(--color-accent-2)] transition-colors"
          rel="noopener noreferrer"
          target="_blank"
          aria-label="GitHub profile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
          GitHub
        </a>

        <!-- Instagram -->
        <a
          href={profile.socials.instagram}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-accent-2)] hover:text-[var(--color-accent-2)] transition-colors"
          rel="noopener noreferrer"
          target="_blank"
          aria-label="Instagram profile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
          </svg>
          Instagram
        </a>

        {/* LinkedIn — conditional, ONLY when defined */}
        {profile.socials.linkedin && (
          <a
            href={profile.socials.linkedin}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
            rel="noopener noreferrer"
            target="_blank"
            aria-label="LinkedIn profile"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect width="4" height="12" x="2" y="9" />
              <circle cx="4" cy="4" r="2" />
            </svg>
            LinkedIn
          </a>
        )}

        {/* Twitter — conditional, ONLY when defined */}
        {profile.socials.twitter && (
          <a
            href={profile.socials.twitter}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
            rel="noopener noreferrer"
            target="_blank"
            aria-label="Twitter profile"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z" />
            </svg>
            Twitter
          </a>
        )}
      </div>

      <p class="text-[var(--color-muted)]">
        Based in {profile.location.current} — relocating to{" "}
        {profile.location.target}.
      </p>
    </div>
  </div>
</section>
