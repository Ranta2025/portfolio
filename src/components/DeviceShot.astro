---
import { Image } from "astro:assets";
import type { ResolvedShot } from "../lib/shots";

interface Props {
  shot: ResolvedShot;
  sizes: string;
  eager?: boolean;
  caption?: boolean;
}

const { shot, sizes, eager = false, caption = false } = Astro.props;
const widths = [480, 800, 1200, 1600, 2000].filter((w) => w <= shot.image.width);
---

<figure class:list={["device", `device--${shot.frame}`]}>
  <div class="device-body">
    {
      (shot.frame === "browser" || shot.frame === "window") && (
        <div class="device-bar" aria-hidden="true">
          <span class="dots">
            <i />
            <i />
            <i />
          </span>
        </div>
      )
    }
    <Image
      src={shot.image}
      alt={shot.alt}
      widths={widths.length ? widths : [shot.image.width]}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="device-screen"
    />
  </div>
  {caption && <figcaption>{shot.alt}</figcaption>}
</figure>

<style>
  .device {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }
  .device-body {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--device);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 12px 32px -8px rgb(0 0 0 / 0.18),
      0 0 0 1px var(--device-edge);
  }
  .device-screen {
    display: block;
    width: 100%;
    height: auto;
  }

  .device--browser .device-body,
  .device--window .device-body {
    border-radius: 10px;
  }
  .device-bar {
    display: flex;
    align-items: center;
    height: 2rem;
    padding-inline: 0.875rem;
    background: var(--device-bar);
    border-bottom: 1px solid var(--device-edge);
  }
  .dots {
    display: flex;
    gap: 0.375rem;
  }
  .dots i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--device-edge);
  }

  .device--phone .device-body {
    max-width: 19rem;
    padding: 0.625rem;
    border-radius: 2.5rem;
  }
  .device--phone .device-screen {
    border-radius: 1.9rem;
  }

  .device--landscape .device-body {
    padding: 0.625rem;
    border-radius: 2rem;
  }
  .device--landscape .device-screen {
    border-radius: 1.4rem;
  }

  figcaption {
    font-size: 0.875rem;
    color: var(--muted);
    text-align: center;
    max-width: 32rem;
  }
</style>
