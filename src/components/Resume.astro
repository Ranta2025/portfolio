---
import Base from "../layouts/Base.astro";
import { cv, type Lang } from "../data/cv";
import { profile } from "../data/profile";
import { site } from "../data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = cv[lang];
const otherHref = lang === "en" ? "/cv/es/" : "/cv/";
const siteHost = new URL(site.url).host;
---

<Base title="CV" description={`${profile.name} — ${c.role}`} bare>
  <div class="toolbar">
    <a href="/">← {siteHost}</a>
    <a href={otherHref}>{c.labels.otherLang}</a>
    <a href={`/rafael-tanda-cv-${lang}.pdf`} download>PDF</a>
    <button type="button" onclick="window.print()">{c.labels.print}</button>
  </div>

  <article class="sheet" lang={lang}>
    <header class="cv-head">
      <h1>{profile.name}</h1>
      <p class="cv-role">{c.role}</p>
      <ul class="cv-contact">
        <li>{c.location}</li>
        <li>{c.authorization}</li>
      </ul>
      <ul class="cv-contact">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.links.github}>github.com/Ranta2025</a></li>
        {profile.links.linkedin && <li><a href={profile.links.linkedin}>LinkedIn</a></li>}
        <li><a href={site.url}>{siteHost}</a></li>
      </ul>
    </header>

    <section>
      <h2>{c.labels.summary}</h2>
      <p>{c.summary}</p>
    </section>

    <section>
      <h2>{c.labels.projects}</h2>
      {
        c.projects.map((p) => (
          <div class="cv-item">
            <div class="cv-item-head">
              <h3>{p.title}</h3>
              <span class="cv-period">{p.period}</span>
            </div>
            <p class="cv-stack">
              {p.stack}
              {p.repo && <> · <a href={`https://${p.repo}`}>{p.repo}</a></>}
            </p>
            <ul>{p.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
        ))
      }
    </section>

    <section>
      <h2>{c.labels.skills}</h2>
      <dl class="cv-skills">
        {
          c.skills.map((s) => (
            <>
              <dt>{s.area}</dt>
              <dd>{s.items}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <div class="cv-two">
      <section>
        <h2>{c.labels.education}</h2>
        <p>{c.education}</p>
      </section>
      <section>
        <h2>{c.labels.languages}</h2>
        <p>{c.languages.join(" · ")}</p>
      </section>
    </div>
  </article>
</Base>

<style>
  :global(body) {
    background: var(--surface);
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    font-size: 0.875rem;
  }
  .toolbar button {
    font: inherit;
    padding: 0.4rem 0.875rem;
    border: 1px solid var(--text);
    border-radius: 6px;
    background: var(--text);
    color: var(--bg);
    cursor: pointer;
  }

  .sheet {
    width: min(210mm, 100% - 2rem);
    margin: 0 auto 2rem;
    padding: clamp(1.25rem, 5vw, 14mm) clamp(1.25rem, 5vw, 15mm);
    background: #fff;
    color: #17171a;
    font-size: 9.2pt;
    line-height: 1.38;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08), 0 8px 24px rgb(0 0 0 / 0.06);
  }
  .sheet a {
    color: inherit;
    text-decoration: none;
  }
  .cv-head h1 {
    font-family: var(--font-serif);
    font-size: 22pt;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .cv-role {
    margin-top: 1mm;
    font-size: 11pt;
    color: #0f6b4f;
    font-weight: 500;
  }
  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 3.5mm;
    margin-top: 1mm;
    list-style: none;
    color: #4d4d55;
    font-size: 8.6pt;
  }
  .cv-role + .cv-contact {
    margin-top: 2mm;
  }
  .cv-contact li + li::before {
    content: "·";
    margin-right: 3.5mm;
    color: #b5b5bb;
  }
  section {
    margin-top: 3.4mm;
  }
  h2 {
    margin-bottom: 1.8mm;
    padding-bottom: 1mm;
    border-bottom: 0.6pt solid #d9d6cc;
    font-family: var(--font-mono);
    font-size: 7.8pt;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b6b72;
  }
  .cv-item {
    break-inside: avoid;
  }
  .cv-item + .cv-item {
    margin-top: 2.6mm;
  }
  .cv-item-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
  }
  h3 {
    font-size: 10pt;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .cv-period {
    flex-shrink: 0;
    font-size: 8.6pt;
    color: #6b6b72;
  }
  .cv-stack {
    margin-top: 0.4mm;
    font-family: var(--font-mono);
    font-size: 7.6pt;
    color: #6b6b72;
  }
  .cv-item ul {
    margin-top: 1mm;
    padding-left: 4mm;
  }
  .cv-item li + li {
    margin-top: 0.6mm;
  }
  .cv-skills {
    display: grid;
    grid-template-columns: 32mm 1fr;
    gap: 0.8mm 3mm;
    margin: 0;
  }
  .cv-skills dt {
    font-weight: 600;
  }
  .cv-skills dd {
    margin: 0;
  }
  .cv-two {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 6mm;
  }

  @media (max-width: 40rem) {
    .cv-item-head {
      flex-direction: column;
      gap: 0;
    }
    .cv-skills,
    .cv-two {
      grid-template-columns: 1fr;
    }
  }

  @page {
    size: A4;
    margin: 0;
  }
  @media print {
    :global(body) {
      background: #fff;
    }
    .toolbar {
      display: none;
    }
    .sheet {
      width: 210mm;
      margin: 0;
      padding: 10mm 13mm;
      box-shadow: none;
    }
  }
</style>
