---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

const mainProjects = projects.filter((p) => p.type !== "mini");
const miniProject = projects.find((p) => p.type === "mini");
---

<section id="projects" aria-labelledby="projects-heading" class="py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      id="projects-heading"
      class="text-gradient text-3xl md:text-4xl font-bold mb-12"
    >
      Projects
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {mainProjects.map((project, i) => (
        <div
          class={`reveal ${project.type === "featured" ? "lg:col-span-2" : ""}`}
          style={`transition-delay: ${i * 100}ms`}
        >
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    {miniProject && (
      <p class="text-[var(--color-muted)] mt-8 text-sm">
        Also:{" "}
        <ProjectCard project={miniProject} />
      </p>
    )}
  </div>
</section>
