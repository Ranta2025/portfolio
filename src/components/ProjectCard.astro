---
import type { Project } from "../data/projects";

const { project } = Astro.props as { project: Project };
---

{
  project.type === "mini" ? (
    <a
      href={project.links.github}
      class="font-mono text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors inline-flex items-center gap-1"
      rel="noopener noreferrer"
      target="_blank"
    >
      {project.title}
      <span aria-hidden="true">✦</span>
    </a>
  ) : (
    <article
      class="glass lift rounded-xl p-6 flex flex-col gap-4"
      style={project.type === "featured"
        ? "border-top: 3px solid; border-image: linear-gradient(90deg, var(--color-accent), var(--color-accent-2), var(--color-accent-3)) 1;"
        : ""}
    >
      <h3 class="text-2xl font-bold text-[var(--color-text)]">
        {project.title}
      </h3>

      <p class="text-[var(--color-muted)] leading-relaxed">
        {project.description}
      </p>

      {
        project.type === "featured" && project.features && (
          <ul class="list-disc pl-5 text-[var(--color-muted)] text-sm space-y-1">
            {project.features.map((f) => <li>{f}</li>)}
          </ul>
        )
      }

      <div class="flex flex-wrap gap-2">
        {project.tech.map((t) => (
          <code class="font-mono text-sm bg-[color-mix(in_oklab,var(--color-accent)_8%,transparent)] border border-[var(--color-border)] rounded px-2 py-1">
            {t}
          </code>
        ))}
      </div>

      <div class="flex flex-wrap gap-3 mt-2">
        <a
          href={project.links.github}
          class="inline-flex items-center gap-1.5 text-sm text-[var(--color-accent)] hover:text-[var(--color-accent-2)] transition-colors"
          rel="noopener noreferrer"
          target="_blank"
          aria-label={`View ${project.title} on GitHub`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
          Code
        </a>

        {project.links.live && (
          <a
            href={project.links.live}
            class="inline-flex items-center gap-1.5 text-sm text-[var(--color-accent-3)] hover:text-[var(--color-accent)] transition-colors"
            rel="noopener noreferrer"
            target="_blank"
            aria-label={`View ${project.title} live`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            Live
          </a>
        )}
      </div>
    </article>
  )
}
