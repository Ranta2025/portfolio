---
import Base from "../layouts/Base.astro";
import DeviceShot from "../components/DeviceShot.astro";
import RepoLink from "../components/RepoLink.astro";
import { profile } from "../data/profile";
import { caseStudies, sideProjects } from "../data/projects";
import { stack } from "../data/stack";
import { resolveShots } from "../lib/shots";

const work = caseStudies.map((study) => ({ study, shots: resolveShots(study.slug, study.shots) }));

const heroBrowser = work.find((w) => w.study.slug === "chatapp")?.shots.find((s) => s.frame === "browser");
const heroPhone = work.find((w) => w.study.slug === "salon-manager")?.shots[0];

const principles = [
  {
    title: "Local first, network second",
    body: "The device holds the truth. Sync is explicit, queued and safe to retry, so a lost connection is a normal state, not an error.",
  },
  {
    title: "Budgets before features",
    body: "Target hardware, APK size, frame time and draw calls are written down before the first scene. If it doesn't fit, it doesn't ship.",
  },
  {
    title: "Decisions on paper",
    body: "Every repository explains why each tool was chosen and what was rejected, so the next person doesn't have to guess.",
  },
  {
    title: "Tests against real things",
    body: "Real SQLite in memory, real Postgres in integration, real browsers in e2e. Mocks only where the boundary is truly external.",
  },
  {
    title: "Agents type, I own the result",
    body: "Coding agents write most of the first draft from my specs. Every change still lands in small units, behind tests and a review of the diff, before it merges.",
  },
];
---

<Base>
  <section class="hero container">
    <div class="hero-text">
      <p class="status">
        <span class="status-dot" aria-hidden="true"></span>
        {profile.availability} · EU work authorization
      </p>
      <h1 class="hero-title">{profile.headline}</h1>
      <p class="hero-intro muted">{profile.intro}</p>
      <div class="hero-actions">
        <a class="button primary" href="#work">See selected work</a>
        <a class="button" href="/cv/">CV</a>
        <a class="button" href={`mailto:${profile.email}`}>Email me</a>
      </div>
      <p class="hero-meta mono">
        {profile.role} · {profile.location.current} → {profile.location.next}
      </p>
    </div>
    {
      heroBrowser && (
        <div class="hero-visual" aria-hidden="true">
          <div class="hero-browser">
            <DeviceShot shot={heroBrowser} sizes="(min-width: 64rem) 36rem, 90vw" eager />
          </div>
          {heroPhone && (
            <div class="hero-phone">
              <DeviceShot shot={heroPhone} sizes="12rem" eager />
            </div>
          )}
        </div>
      )
    }
  </section>

  <section id="work" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2 class="section-title">Four systems, four sets of constraints</h2>
      </div>

      <ol class="work-list">
        {
          work.map(({ study, shots }, i) => (
            <li class:list={["feature", { "feature--flip": i % 2 === 1, "feature--text": !shots.length }]}>
              <div class="feature-text">
                <p class="eyebrow">
                  {String(i + 1).padStart(2, "0")} · {study.kind}
                </p>
                <h3 class="feature-title">
                  <a href={`/work/${study.slug}/`}>{study.title}</a>
                </h3>
                <p class="muted">{study.summary}</p>
                <ul class="feature-metrics">
                  {study.metrics.slice(0, 3).map((m) => (
                    <li>
                      <strong>{m.value}</strong>
                      <span class="muted">{m.label}</span>
                    </li>
                  ))}
                </ul>
                <p class="feature-links">
                  <a class="feature-cta" href={`/work/${study.slug}/`}>
                    Read the case study →
                  </a>
                  <RepoLink repo={study.repo} />
                </p>
              </div>
              {shots[0] && (
                <a class="feature-visual" href={`/work/${study.slug}/`} tabindex="-1" aria-hidden="true">
                  <DeviceShot shot={shots[0]} sizes="(min-width: 64rem) 34rem, 90vw" />
                </a>
              )}
            </li>
          ))
        }
      </ol>

      <div class="side">
        <h3 class="side-title">Also built</h3>
        <ul class="side-list">
          {
            sideProjects.map((p) => (
              <li>
                <p class="side-name">
                  {"url" in p.repo ? (
                    <a href={p.repo.url} rel="noopener noreferrer" target="_blank">
                      {p.title}
                    </a>
                  ) : (
                    <span>{p.title}</span>
                  )}
                  {p.status && <span class="badge">{p.status}</span>}
                </p>
                <p class="muted">{p.summary}</p>
                <ul class="tags">{p.stack.map((s) => <li>{s}</li>)}</ul>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How I work</p>
        <h2 class="section-title">Principles that show up in the code</h2>
      </div>
      <div class="principles">
        {
          principles.map((p, i) => (
            <article>
              <span class="mono principle-index">{String(i + 1).padStart(2, "0")}</span>
              <h3>{p.title}</h3>
              <p class="muted">{p.body}</p>
            </article>
          ))
        }
      </div>

      <div class="about-grid">
        <div>
          <h3 class="side-title">Stack</h3>
          <dl class="stack">
            {
              stack.map((g) => (
                <div>
                  <dt class="eyebrow">{g.area}</dt>
                  <dd>
                    <ul class="tags">{g.items.map((i) => <li>{i}</li>)}</ul>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div>
          <h3 class="side-title">Background</h3>
          <ul class="list muted">
            <li>
              {profile.education.degree}, {profile.education.school} — {profile.education.status}.
            </li>
            <li>{profile.workAuthorization}.</li>
            {profile.languages.map((l) => <li>{l}.</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="section contact-section">
    <div class="container contact">
      <p class="eyebrow">Contact</p>
      <h2 class="contact-title">Building something that has to work offline, or under pressure?</h2>
      <p class="muted prose">I answer every email. Tell me what you are building and what is getting in the way.</p>
      <p class="contact-email">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
      <ul class="contact-links">
        <li><a href={profile.links.github} rel="noopener noreferrer" target="_blank">GitHub</a></li>
        {
          profile.links.linkedin && (
            <li>
              <a href={profile.links.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
            </li>
          )
        }
        <li><a href="/cv/">CV (English)</a> · <a href="/rafael-tanda-cv-en.pdf" download>PDF</a></li>
        <li><a href="/cv/es/">CV (Español)</a> · <a href="/rafael-tanda-cv-es.pdf" download>PDF</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding-block: clamp(3.5rem, 10vw, 7rem) clamp(3rem, 8vw, 5rem);
  }
  .hero-text {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.025em;
    max-width: 18ch;
  }
  .hero-intro {
    font-size: 1.125rem;
    max-width: var(--measure);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero-meta {
    color: var(--faint);
  }
  .hero-visual {
    position: relative;
    padding: 0 0 3rem 0;
  }
  .hero-browser {
    transform: rotate(-1deg);
  }
  .hero-phone {
    position: absolute;
    right: -0.5rem;
    bottom: 0;
    width: 34%;
    max-width: 11rem;
    transform: rotate(3deg);
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3.5rem, 9vw, 6rem);
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }
  .feature-text {
    display: grid;
    gap: 0.875rem;
    align-content: start;
  }
  .feature-title {
    font-family: var(--font-serif);
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    font-weight: 500;
  }
  .feature-title a {
    text-decoration: none;
  }
  .feature-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }
  .feature-metrics li {
    display: grid;
    gap: 0.125rem;
  }
  .feature-metrics strong {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.1;
  }
  .feature-metrics span {
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .feature-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    font-size: 0.9375rem;
  }
  .feature-cta {
    font-weight: 600;
    text-decoration: none;
    color: var(--accent);
  }
  .feature-visual {
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    background: var(--panel);
    border-radius: 16px;
    text-decoration: none;
    transition: transform 0.25s ease;
  }
  .feature-visual:hover {
    transform: translateY(-3px);
  }
  @media (min-width: 56rem) {
    .feature {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
    .feature--flip .feature-text {
      order: 2;
    }
    .feature--text {
      grid-template-columns: minmax(0, 1fr);
      max-width: var(--measure);
    }
  }

  .side {
    margin-top: clamp(4rem, 9vw, 6rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .side-title {
    font-size: 1rem;
    margin-bottom: 1.25rem;
  }
  .side-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 2rem;
    list-style: none;
  }
  .side-list > li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .side-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .principles article {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem;
    background: var(--bg);
  }
  .principle-index {
    color: var(--accent);
  }
  .principles h3 {
    font-size: 1.0625rem;
  }
  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 3rem;
    margin-top: 4rem;
  }
  .stack {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }
  .stack dd {
    margin: 0.375rem 0 0;
  }

  .contact-section {
    background: var(--panel);
  }
  .contact {
    display: grid;
    gap: 1rem;
  }
  .contact-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    max-width: 20ch;
  }
  .contact-email {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 4.5vw, 1.75rem);
    overflow-wrap: anywhere;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
  }
</style>
